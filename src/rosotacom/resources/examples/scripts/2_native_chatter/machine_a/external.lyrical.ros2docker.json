{
  "container_name": "machine_a_logic_lyrical",
  "image_name": "rosotacom-native-chatter-lyrical",

  "run_type": "command",
  "command": "/wait_for_echo_topic.sh",

  "run_args": [
    "--network", "host",
    "-v", "./wait_for_echo_topic.sh:/wait_for_echo_topic.sh",
    "-e", "RMW_IMPLEMENTATION=rmw_cyclonedds_cpp",
    "-e", "ROS_DOMAIN_ID=46"
