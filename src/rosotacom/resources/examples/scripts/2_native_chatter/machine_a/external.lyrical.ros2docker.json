  "build_args": {
    "BASE_IMAGE": "ros:lyrical-ros-base-resolute",
    "DIGEST": "@sha256:0eea195bb91662a7dfbd6c6b026c209aef1d091e55ce37733e54509580ddf2c8",
    "APT_PACKAGES": "ros-lyrical-rmw-cyclonedds-cpp"
  }
}
