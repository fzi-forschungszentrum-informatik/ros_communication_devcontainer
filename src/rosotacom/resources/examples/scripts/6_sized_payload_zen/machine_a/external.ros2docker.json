{
  "container_name": "machine_a_logic",

  "run_type": "catmux",
  "catmux_file": "/external_session.yaml",

  "run_args": [
    "--network", "host",
    "-v", "./external_session.yaml:/external_session.yaml",
    "-v", "../../../ws:/ws",
    "-e", "ROS_DOMAIN_ID=46",
    "-e", "BUILD_ROS2WS=1"
  ],

  "build_args": {
    "BASE_IMAGE":                    "ros:kilted-ros-base-noble"
  }
}
