<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>vpn_udp</transport_id>
        <type>UDPv4</type>

        <!-- Wenn der Peer-Port in initialPeersList nicht angegeben wird,
             durchsucht Fast DDS Kandidaten-Participant-IDs von 0 bis maxInitialPeersRange. -->
        <!-- <maxInitialPeersRange>4</maxInitialPeersRange> -->

        <!-- Harte Bindung an die lokale VPN-Adresse -->
        <interfaceWhiteList>
          <address>#host_ip</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="ota_unicast_participant" is_default_profile="true">
      <!-- <domainId>#domain_id</domainId> -->

      <rtps>
        <!-- Expliziter User-Data-Unicast-Listener auf der VPN-IP.
             port=0 => Well-Known-Port automatisch aus Domain + participantID -->
        <defaultUnicastLocatorList>
          <locator>
            <udpv4>
              <address>#host_ip</address>
              <port>0</port>
            </udpv4>
          </locator>
        </defaultUnicastLocatorList>

        <builtin>
          <!-- Discovery nur per Unicast auf der VPN-IP -->
          <metatrafficUnicastLocatorList>
            <locator>
              <udpv4>
                <address>#host_ip</address>
                <port>0</port>
              </udpv4>
            </locator>
          </metatrafficUnicastLocatorList>

          <!-- Nur bekannte Gegenstelle(n) -->
          <initialPeersList>
            <!--peer-block--><locator>
              <udpv4>
                <address>#peer</address>
              </udpv4>
            </locator><!--/peer-block-->
          </initialPeersList>
        </builtin>

        <!-- Nur den explizit definierten UDPv4-Transport benutzen -->
        <userTransports>
          <transport_id>vpn_udp</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
